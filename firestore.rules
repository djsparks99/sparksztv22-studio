rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // Channels
    match /channels/{channelId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
    
    // Chat messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // Follows
    match /follows/{followId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Shoutbox Ticker
    match /shoutbox/{shoutId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // Lounge chat messages
    match /lounge_messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email == "markysparks99@gmail.com";
    }

    // Lounge music mixes
    match /lounge_mixes/{mixId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.token.email == "markysparks99@gmail.com");
    }

    // Lounge host/admin featured tracks
    match /lounge_featured/{trackId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.token.email == "markysparks99@gmail.com";
    }
  }
}
