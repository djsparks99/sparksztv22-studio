# Environment Variables Example for Sparkz.TV

# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Amazon IVS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Backend Base URL (Optional: Defaults to relative /api routing if empty)
VITE_API_URL=
VITE_BACKEND_URL=
REACT_APP_BACKEND_URL=

# JWT Secret Key
JWT_SECRET=
